# ===== FixPhone production environment =====
# Salin menjadi .env.production, isi semua nilai, lalu jalankan:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# Jangan pernah commit .env.production. File ini hanya templat.
# Nilai rahasia di bawah WAJIB diganti sebelum go-live.

# ---- Identitas & domain -----------------------------------------------------
APP_ENV=production
APP_BASE_URL=https://fixphone.example.com
APP_DOMAIN=fixphone.example.com
ACME_EMAIL=ops@example.com
TZ=Asia/Jakarta
LOG_LEVEL=info
# Origin browser yang diizinkan (harus https, tanpa trailing slash).
CORS_ORIGINS=https://fixphone.example.com
# Batasi ke subnet Docker/server Anda. Contoh default Docker: 172.16.0.0/12.
TRUSTED_PROXIES=172.16.0.0/12

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=GANTI_PASSWORD_POSTGRES_KUAT
POSTGRES_DB=fixphone

# Pemilik skema: dipakai migrasi, seed, set-app-role, doctor, dan worker.
# Di production jangan memakai akun ini untuk melayani request HTTP.
DB_ADMIN_DSN=postgres://postgres:GANTI_PASSWORD_POSTGRES_KUAT@db:5432/fixphone?sslmode=disable

# Role aplikasi RLS (dibuat NOLOGIN oleh migrasi 000019, diaktifkan oleh
# set-app-role). Password harus sama dengan yang ada di DB_DSN.
APP_DB_PASSWORD=GANTI_PASSWORD_APP_MINIMAL_32_KARAKTER
DB_DSN=postgres://fixphone_app:GANTI_PASSWORD_APP_MINIMAL_32_KARAKTER@db:5432/fixphone?sslmode=disable

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# ---- Rahasia aplikasi -------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=GANTI_DENGAN_RANDOM_MINIMAL_32_KARAKTER
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION=15m
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=1m
# openssl rand -base64 32  (harus tepat 32 byte setelah decode)
APP_ENC_KEY=GANTI_BASE64_32_BYTE

# ---- Super admin awal -------------------------------------------------------
# Dibuat hanya jika belum ada. Password TIDAK direset oleh seed berikutnya;
# tetap ganti setelah login pertama (must_change_password=true).
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_EMAIL=admin@fixphone.example.com
SEED_SUPERADMIN_PASSWORD=GANTI_PASSWORD_SUPERADMIN_KUAT
SEED_DEMO=false

# ---- Upload & WhatsApp ------------------------------------------------------
UPLOAD_MAX_MB=5
VITE_API_BASE_URL=/api/v1
WA_FONNTE_TOKEN=
WA_WABLAS_TOKEN=
WA_WABLAS_SECRET=
WA_WABLAS_URL=https://console.wablas.com

# ---- Worker -----------------------------------------------------------------
WORKER_OUTBOX_INTERVAL=30s
WORKER_REMINDER_INTERVAL=15m
WORKER_PURGE_INTERVAL=1h

# ---- Monitoring -------------------------------------------------------------
# Token opsional untuk /metrics. Bila diisi, Prometheus otomatis memakainya.
METRICS_TOKEN=
# Webhook Alertmanager (Slack/Teams/relay). Kosong = alert hanya di UI.
ALERT_WEBHOOK_URL=

# ---- Backup ----------------------------------------------------------------
# Backup harian memakai DB_ADMIN_DSN; BACKUP_DSN opsional untuk akun read-only.
# Tombol backup manual per tenant di UI memakai BACKUP_DSN; bila kosong, API
# memakai DB_ADMIN_DSN secara otomatis.
BACKUP_RETENTION_DAYS=14
BACKUP_SCHEDULE="15 2 * * *"
RESTORE_DRILL_SCHEDULE="15 3 * * 0"
# Isi untuk mengaktifkan uji restore mingguan ke database scratch yang sudah
# dibuat (mis. CREATE DATABASE fixphone_drill OWNER postgres).
RESTORE_DRILL_DSN=
RESTORE_DRILL_MIN_TABLES=25
# Contoh rclone remote: b2:fixphone-backup (konfigurasi di deploy/backup/config).
BACKUP_REMOTE=
# Kunci publik age untuk enkripsi artefak sebelum dikirim offsite.
BACKUP_AGE_RECIPIENT=

# ---- Build metadata ---------------------------------------------------------
FIXPHONE_VERSION=1.0.0
GIT_COMMIT=unknown
BUILD_DATE=unknown
