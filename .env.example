# ===== FixPhone environment template =====
# Salin menjadi .env lalu ganti semua nilai rahasia.
# .env tidak boleh di-commit.

APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:5173
LOG_LEVEL=debug

# PostgreSQL development (portable scripts/dev-db.ps1 atau Docker Compose,
# keduanya memakai port host 55432).
# Produksi: gunakan DSN terkelola dengan TLS, mis. sslmode=require.
DB_DSN=postgres://postgres:postgres@127.0.0.1:55432/fixphone_dev?sslmode=disable
TEST_DB_DSN=postgres://postgres:postgres@127.0.0.1:55432/fixphone_test?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Wajib minimal 32 karakter. Hasilkan nilai acak, jangan pakai contoh ini.
JWT_SECRET=replace-with-at-least-32-random-characters
# Masa berlaku sesi (opsional, default di bawah).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
# Lockout login: 5 kegagalan dalam 15 menit, rate limit 5 percobaan/menit/IP.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION=15m
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=1m
# Wajib base64 dari tepat 32 byte.
# Contoh membuat: openssl rand -base64 32
APP_ENC_KEY=replace-with-base64-32-bytes
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
UPLOAD_MAX_MB=5

SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_EMAIL=superadmin@fixphone.local
# Minimal 8 karakter, mengandung huruf dan angka.
SEED_SUPERADMIN_PASSWORD=change-this-password
SEED_DEMO=false

# Fitur WhatsApp (Tahap 9). noop = tidak mengirim apa pun.
WA_PROVIDER=noop
WA_API_KEY=
BACKUP_DIR=backups
TZ=Asia/Jakarta
