# ===== FixPhone frontend environment =====
# Development memakai proxy Vite ke http://127.0.0.1:8080, jadi variabel ini
# boleh dikosongkan. Isi bila API berada di origin lain (production).
# VITE_API_BASE_URL=/api/v1
#
# Target proxy Vite saat `npm run dev` (opsional).
# VITE_PROXY_TARGET=http://127.0.0.1:8080
